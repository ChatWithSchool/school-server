# What the deploy workflow writes to /srv/cws/<env>/server.env on the instance (reference only).
# MONGODB_URI and JWT_SECRET come from the GitHub secrets of the environment; the rest is fixed.
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cws_dev?retryWrites=true&w=majority
JWT_SECRET=a-long-random-string-different-for-each-environment
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://cws-dev.safeai613.com
