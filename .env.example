NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/school
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# optional: a separate database for integration tests (the tests are skipped when it is empty)
MONGODB_URI_TEST=
# only for npm run seed against a remote database (Atlas): at least 12 random characters.
# a local database keeps the demo password; the seed refuses a remote one without this.
SEED_PASSWORD=
